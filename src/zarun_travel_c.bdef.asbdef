projection;
strict ( 2 );

define behavior for ZARUN_TRAVEL_C alias Travel
{
  use create;
  use update;
  use delete;

  use association _Booking { create; }
}

define behavior for ZARUN_BOOKING_C alias Booking
{
  use update;
  use delete;

  use association _Travel;
  use association _BookingSupplement { create; }
}

define behavior for ZARUN_BOOKINGSuppl_C alias BookingSuppl
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}